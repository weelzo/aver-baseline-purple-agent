# AVER Baseline Purple Agent Configuration

# Required: OpenRouter API key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Model to use (default: anthropic/claude-3.5-sonnet)
# Popular options:
#   - anthropic/claude-3.5-sonnet (recommended)
#   - openai/gpt-4-turbo
#   - google/gemini-pro
#   - deepseek/deepseek-coder
#   - meta-llama/llama-3.1-70b-instruct
AGENT_MODEL=anthropic/claude-3.5-sonnet

# Optional: Agent port (default: 8001)
AGENT_PORT=8001

# Optional: Agent name (for identification)
AGENT_NAME="AVER Baseline Purple Agent"
